<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway probe for "Check how .NET file and process APIs behave under MO2's VFS" (#35).
    Published NativeAOT win-x64 like the shipped app (ADR-0002), so the probe exercises the same
    BCL code paths the port will. Not part of the port; deleted with the research branch.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <!--
      NativeAOT links /CETCOMPAT by default on x64. Under MO2 2.5.2 (usvfs 0.5.6.1) a CET-compatible exe
      crashes before Main: usvfs's injection stub returns to RtlUserThreadStart with a `ret` the shadow
      stack never saw. Off here to test that hypothesis; cmt-vfs-probe-cet.exe is the CET-on build.
    -->
    <CETCompat>false</CETCompat>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>cmt-vfs-probe</AssemblyName>
    <RootNamespace>CmtVfsProbe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
