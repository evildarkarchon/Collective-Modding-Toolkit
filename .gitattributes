.gitattributes text
.gitignore     text
*.pxd    text diff=python
*.py     text diff=python
*.py3    text diff=python
*.pyw    text diff=python
*.pyx    text diff=python
*.pyz    text diff=python
*.pyi    text diff=python
*.db     binary
*.p      binary
*.pkl    binary
*.pickle binary
*.pyc    binary export-ignore
*.pyo    binary export-ignore
*.pyd    binary
*.ipynb  text eol=lf
*.md     text
* text=auto

# Parity Scenario trees and canned HTTP bodies must reach both the Python driver and the C# tests byte for byte
# (a CRLF, a BOM or an invalid UTF-8 byte is often the point of the scenario), so git must never convert them.
parity/scenarios/**/tree/** -text
parity/scenarios/**/http/** -text
