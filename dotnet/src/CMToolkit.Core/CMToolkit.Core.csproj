<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The app's logic, kept free of any Avalonia reference so it can be tested without a UI and so the trim/AOT
    analyzers see it as a library (IsAotCompatible turns them on at build time, not only at publish).
  -->
  <PropertyGroup>
    <RootNamespace>CMToolkit.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The LibraryImport source generator emits unsafe marshalling code for Win32/NativeMethods.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core logs through ILogger only; the App supplies the cm-toolkit.log provider (the Core seams resolution, #7). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <!-- CRC32 of game files (utils.get_crc32): Microsoft's vectorised implementation, trim- and AOT-safe. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <!-- Decodes the Downgrader's xdelta3 Delta Patches (pyxdelta's replacement; issue #3): pure managed VCDIFF. -->
    <PackageReference Include="VCDiff" Version="5.0.0" />
    <!-- Pinned past VCDiff's transitive 0.46.3, which triggers NU1902 (GHSA-6c8g-7p36-r338; unreachable from VCDiff). -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only seams, such as the Overview gathering without its module and archive steps (overview-tab scenarios). -->
    <InternalsVisibleTo Include="CMToolkit.Tests" />
  </ItemGroup>
</Project>
