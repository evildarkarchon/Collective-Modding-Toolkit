<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Fluent resource-key overrides that tune Fluent Dark to sv_ttk's dark palette. Values were measured from the
    Reference Implementation (Tk 8.6, sv_ttk dark) in the main-window-shell prototype, or taken from its globals.py
    (python-reference tag). App-level resources win over the keys FluentTheme defines, and Fluent's control themes
    read them through DynamicResource, so this layer recolours and resizes without touching any template.
  -->

  <!-- Fonts. Tk rounds 8/10/12/20 pt to 11/13/16/27 px (issue #13); FontSize is in DIPs, 1:1 with Tk pixels. -->
  <FontFamily x:Key="CmtFont">avares://cm-toolkit/Assets/Fonts#Cascadia Mono</FontFamily>
  <x:Double x:Key="CmtFontSmaller">11</x:Double>
  <x:Double x:Key="CmtFontSmall">13</x:Double>
  <x:Double x:Key="CmtFontNormal">16</x:Double>
  <x:Double x:Key="CmtFontLarge">27</x:Double>
  <!-- The line pitch Tk actually uses: GDI tmHeight = round(usWinAscent*s) + round(usWinDescent*s), with Cascadia's
       2226/480 per 2048 em. Avalonia uses the typo/hhea metrics (USE_TYPO_METRICS is set), which are ~13% tighter. -->
  <x:Double x:Key="CmtLineSmaller">15</x:Double>
  <x:Double x:Key="CmtLineSmall">17</x:Double>
  <x:Double x:Key="CmtLineNormal">21</x:Double>
  <x:Double x:Key="CmtLineLarge">35</x:Double>
  <!-- GDI hinting snaps Cascadia's 1200/2048 em advance to whole pixels; Skia doesn't. LetterSpacing = rounded - exact
       restores Tk's line widths, and with them its wraplength wrap points:
       16 px 9.375->9, 13 px 7.617->8, 11 px 6.445->6, 27 px 15.82->16. The values are exact (n * 1200 / 2048 is a
       binary fraction): a rounded 0.383 left a line a hair over whole pixels, which layout rounding made 1 px wider. -->
  <x:Double x:Key="CmtSpacingSmaller">-0.4453125</x:Double>
  <x:Double x:Key="CmtSpacingSmall">0.3828125</x:Double>
  <x:Double x:Key="CmtSpacingNormal">-0.375</x:Double>
  <x:Double x:Key="CmtSpacingLarge">0.1796875</x:Double>

  <!-- The reference's globals.py COLOR_*; Tk named colours are resolved through the Tk 8.6 colour table. -->
  <SolidColorBrush x:Key="CmtDefault" Color="#CACACA" />
  <SolidColorBrush x:Key="CmtGood" Color="#619267" />
  <SolidColorBrush x:Key="CmtBad" Color="#AF5A66" />
  <SolidColorBrush x:Key="CmtInfo" Color="#1E90FF" />
  <SolidColorBrush x:Key="CmtNeutral1" Color="#808080" />
  <SolidColorBrush x:Key="CmtNeutral2" Color="#FFE4C4" />
  <SolidColorBrush x:Key="CmtWarning" Color="#FFA500" />
  <!-- utils.set_theme: style.configure("Update.TFrame", background="pale green"), plus the banner's text and link colours. -->
  <SolidColorBrush x:Key="CmtUpdateBanner" Color="#98FB98" />
  <SolidColorBrush x:Key="CmtUpdateText" Color="#006400" />
  <SolidColorBrush x:Key="CmtUpdateLink" Color="#36648B" />
  <!-- downgrader.py COLOR_OG / COLOR_NG / COLOR_AE ("dodger blue", "SlateBlue1", "salmon"), the Downgrader's labels (DG-3). -->
  <SolidColorBrush x:Key="CmtDowngraderOldGen" Color="#1E90FF" />
  <SolidColorBrush x:Key="CmtDowngraderNextGen" Color="#836FFF" />
  <SolidColorBrush x:Key="CmtDowngraderAnniversary" Color="#FA8072" />
  <!-- COLOR_NOTE and COLOR_INDIE: the F4SE tab's tags. -->
  <SolidColorBrush x:Key="CmtNote" Color="#C5C464" />
  <SolidColorBrush x:Key="CmtIndie" Color="#4B92DA" />

  <!-- sv_ttk greys, measured from its sprites. -->
  <SolidColorBrush x:Key="SvBg" Color="#1C1C1C" />
  <SolidColorBrush x:Key="SvStrip" Color="#2F2F2F" />
  <SolidColorBrush x:Key="SvHover" Color="#292929" />
  <SolidColorBrush x:Key="SvSep" Color="#2F2F2F" />
  <!-- sv_ttk radio sprites, sampled from the Settings tab: the unselected ring and fill, and the selected disc. -->
  <SolidColorBrush x:Key="SvRadioBorder" Color="#929292" />
  <SolidColorBrush x:Key="SvRadioFill" Color="#191919" />
  <SolidColorBrush x:Key="SvAccent" Color="#3CD648" />
  <!-- sv_ttk's -fg, which tk_setPalette gives classic Tk widgets such as the log pane's Text, and the Text's 1 px
       sunken relief (dark top-left, light bottom-right), sampled from the Downgrader. -->
  <SolidColorBrush x:Key="SvFg" Color="#FAFAFA" />
  <SolidColorBrush x:Key="SvSunkenDark" Color="#555555" />
  <SolidColorBrush x:Key="SvSunkenLight" Color="#8E8E8E" />
  <!-- sv_ttk's heading-rest sprite (the Treeview heading cells): its lighter top edge and its fill, sampled from the F4SE tab. -->
  <SolidColorBrush x:Key="SvHeadingEdge" Color="#313131" />
  <SolidColorBrush x:Key="SvHeadingFill" Color="#2A2A2A" />
  <!-- ttk.Entry at rest (sv_ttk entry-rest sprite), sampled from the Archive Patcher's Name Filter: its field and
       its 1 px bottom line. -->
  <SolidColorBrush x:Key="SvEntryUnderline" Color="#989898" />

  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <!-- ttk.Button: sv_ttk's 4 px sprite border plus its (8, 4) padding round a FONT_SMALL line to text + 24 by
       line + 13 px (measured on the Tools tab), less Fluent's 1 px border. -->
  <Thickness x:Key="ButtonPadding">11,5,11,6</Thickness>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Window -->
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#1C1C1C" />

      <!-- Button: sv_ttk button-* sprites. -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#2A2A2A" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2F2F2F" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#232323" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2F2F2F" />
      <SolidColorBrush x:Key="ButtonForeground" Color="#CACACA" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#CACACA" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#D0D0D0" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#7A7A7A" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#313131" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#353535" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2C2C2C" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#2F2F2F" />

      <!-- GroupBox (ttk.Labelframe): thin rounded #2f2f2f outline with the label in the notch. -->
      <SolidColorBrush x:Key="GroupBoxBackground" Color="Transparent" />
      <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#2F2F2F" />
      <SolidColorBrush x:Key="GroupBoxHeaderForeground" Color="#CACACA" />
      <x:Double x:Key="GroupBoxHeaderFontSize">13</x:Double>
      <Thickness x:Key="GroupBoxBorderThickness">1</Thickness>
      <Thickness x:Key="GroupBoxPadding">0,2,0,0</Thickness>

      <!-- ToolTip: tkinter-tooltip draws a tk.Message in a 1 px black-bordered Toplevel, in palette colours. -->
      <SolidColorBrush x:Key="ToolTipBackground" Color="#1C1C1C" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#000000" />
      <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
      <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>

      <!-- ScrollBar: sv_ttk scrollbar-* sprites (trough #292929, thumb #9e9e9e, always visible). -->
      <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#292929" />
      <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#292929" />
      <Color x:Key="ScrollBarThumbBackgroundColor">#9E9E9E</Color>
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#B0B0B0" />
      <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#B0B0B0" />
      <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#9E9E9E" />

      <!-- TableView rows and headers (sv_ttk heading-* sprites, Treeview selected row #292929). -->
      <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#1C1C1C" />
      <!-- ttk.Treeview rowheight = sv_ttk body linespace + 3 = ~22 px; Fluent's TableView rows are 42 px (6,9,6,12). -->
      <Thickness x:Key="TableViewRowPadding">0,2,0,3</Thickness>
      <Thickness x:Key="TableViewColumnResizerMargin">0,-2,-6,-3</Thickness>
      <SolidColorBrush x:Key="TableViewRowBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TableViewRowBackgroundSelected" Color="#292929" />
      <SolidColorBrush x:Key="TableViewRowBackgroundSelectedPointerOver" Color="#292929" />

      <!-- The Scanner's results ttk.Treeview: sv_ttk's grey #292929 selected row with bright text, no hover fill. -->
      <x:Double x:Key="TreeViewItemMinHeight">21</x:Double>
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#292929" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#292929" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#292929" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TreeViewItemForeground" Color="#CACACA" />
      <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#CACACA" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FAFAFA" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FAFAFA" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#FAFAFA" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
