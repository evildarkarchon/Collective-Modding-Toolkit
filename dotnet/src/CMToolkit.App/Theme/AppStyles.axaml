<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The equivalents of utils.set_theme()'s style.configure(...) calls (SHELL-14): app-wide font and foreground
    defaults. Shape changes live in ShellControlThemes.axaml, colours in SvPalette.axaml.
  -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource CmtFont}" />
    <Setter Property="Background" Value="{DynamicResource SvBg}" />
    <Setter Property="Foreground" Value="{DynamicResource CmtDefault}" />
  </Style>

  <!--
    Text metrics that reproduce Tk/GDI layout (see SvPalette CmtLine*/CmtSpacing*). The selector is :is(TextBlock)
    rather than TextBlock because string content in Button/TabItem renders through AccessText, a TextBlock
    subclass, and a plain type selector only matches the exact type. Later styles win, so general comes first.
  -->
  <Style Selector=":is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource CmtFontNormal}" />
    <Setter Property="LineHeight" Value="{DynamicResource CmtLineNormal}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource CmtSpacingNormal}" />
  </Style>
  <!-- style.configure("TButton"/"TCheckbutton"/"TRadiobutton"/"TLabelframe.Label"/"Treeview"/"Heading", font=FONT_SMALL) -->
  <Style Selector=":is(TextBlock).small, Button :is(TextBlock), CheckBox :is(TextBlock), RadioButton :is(TextBlock), TableView :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource CmtFontSmall}" />
    <Setter Property="LineHeight" Value="{DynamicResource CmtLineSmall}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource CmtSpacingSmall}" />
  </Style>
  <!-- FONT_LARGE (20 pt): the tabs' loading labels, and later the About tab title. -->
  <Style Selector=":is(TextBlock).large">
    <Setter Property="FontSize" Value="{DynamicResource CmtFontLarge}" />
    <Setter Property="LineHeight" Value="{DynamicResource CmtLineLarge}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource CmtSpacingLarge}" />
  </Style>
  <!-- Tooltips are a tk.Message in TkDefaultFont (Segoe UI 9 pt), not Cascadia, so the Cascadia tuning is undone. -->
  <Style Selector="ToolTip :is(TextBlock)">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="LetterSpacing" Value="0" />
  </Style>

  <!-- tkinter-tooltip defaults: delay=0, follow=True, +10/+10 from the pointer. -->
  <Style Selector=":is(Control)">
    <Setter Property="ToolTip.ShowDelay" Value="0" />
    <Setter Property="ToolTip.Placement" Value="Pointer" />
    <Setter Property="ToolTip.HorizontalOffset" Value="10" />
    <Setter Property="ToolTip.VerticalOffset" Value="10" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- style.configure("Heading", font=FONT_SMALL) is regular weight; Fluent's headers are SemiBold. -->
  <Style Selector="TableViewColumnHeader">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- ttk.Scrollbar is always visible, with arrow buttons; Fluent's is an auto-hiding overlay. -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>

  <!-- A ttk.Button centres its label block in a stretched button (Fluent puts it on the left). The lines of a
       multi-line label stay left-justified within the block, which is why the Tools tab's texts pad with spaces. -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ttk.Labelframe(labelanchor=N): the title centred on the top edge. -->
  <Style Selector="GroupBox.centred">
    <Setter Property="Theme" Value="{DynamicResource CentredGroupBox}" />
  </Style>

  <!-- Accent.TButton (the Scanner's Scan Game): sv_ttk's accent sprite, black text on the green. Disabled, Fluent's
       disabled template styles win, giving the plain disabled button as sv_ttk's accent-disabled sprite does. -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource SvAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SvAccent}" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#000000" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#57DE61" />
    <Setter Property="BorderBrush" Value="#57DE61" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33B83E" />
    <Setter Property="BorderBrush" Value="#33B83E" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>
  <!-- These app styles outrank Fluent's own :disabled ones, so the disabled look is restated. -->
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
  </Style>

  <!-- ttk.Button(padding=0), the Scanner's Collapse All / Expand All: the label's own size plus the sprite border. -->
  <Style Selector="Button.tight">
    <Setter Property="Padding" Value="3" />
  </Style>

  <!-- The Scanner's results ttk.Treeview: style.configure("Treeview", font=FONT_SMALL), ~21 px rows (prototype). -->
  <Style Selector="TreeView.results TreeViewItem">
    <Setter Property="MinHeight" Value="21" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TreeView.results TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="MinHeight" Value="21" />
  </Style>
  <!-- Tk's indicator sits 2 px further left with its text 7 px closer, and item text is 20 px (not 16) deeper than a
       group's: measured from parity/screenshots/scanner/results. -->
  <Style Selector="TreeView.results TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
    <Setter Property="Margin" Value="10,0,5,0" />
  </Style>
  <Style Selector="TreeView.results TreeViewItem.leaf">
    <Setter Property="Padding" Value="5,0,0,0" />
  </Style>
  <Style Selector="TreeView.results :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource CmtFontSmall}" />
    <Setter Property="LineHeight" Value="{DynamicResource CmtLineSmall}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource CmtSpacingSmall}" />
  </Style>
</Styles>
