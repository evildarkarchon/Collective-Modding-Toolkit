<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CMToolkit.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!--
      xunit.v3 is pinned to 3.2.x, not 4.x: Avalonia.Headless.XUnit 12.1.3 is compiled against
      xunit.v3.extensibility.core 3.2.2, and a major-version mismatch there isn't a supported combination.
    -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CMToolkit.Core\CMToolkit.Core.csproj" />
    <ProjectReference Include="..\..\src\CMToolkit.App\CMToolkit.App.csproj" />
  </ItemGroup>
</Project>
