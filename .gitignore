# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
*.code-workspace
lcov.info

# exe Build Files
*.exe
build/
dist/

# Test/Dev Files
test.*

# Runtime-Created Files
*.xdelta
cm-toolkit.log

# Parity Scenario trees and canned HTTP bodies are fake machines committed verbatim: an empty Fallout4.exe or a
# *.xdelta there is a fixture, not a build or runtime artifact.
!parity/scenarios/**/tree/**
!parity/scenarios/**/http/**
# The parity asset toolchains' built outputs (stub exes and the like) are committed, so scenarios can copy them.
!parity/assets/*/out/**
