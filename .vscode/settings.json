{
  "dotnet.defaultSolution": "dotnet/CMToolkit.slnx",
  "files.exclude": {
    ".git/": true,
    ".vscode/": false,
    "**/*.exe": true,
    "**/lcov.info": true,
    "**/bin/": true,
    "**/obj/": true,
    "dotnet/artifacts/": true
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "todo-tree.tree.scanMode": "workspace only",
  "todo-tree.general.tags": [
    "BUG:",
    "HACK:",
    "TODO:",
    "GUI:",
    "F4SE:",
    "Scanner:",
    "Overview:",
    "Errors:",
    "Conflicts:",
    "Suggestions:",
    "Tools:",
    "Settings:",
    "About:"
  ],
  "todo-tree.highlights.useColourScheme": true,
  "todo-tree.highlights.foregroundColourScheme": [
    "Black", // BUG:
    "Black", // HACK:
    "Black", // TODO:
    "White", // GUI:
    "White", // F4SE:
    "White", // Scanner:
    "White", // Overview:
    "White", // Errors:
    "White", // Conflicts:
    "Sienna", // Suggestions:
    "Thistle", // Tools:
    "Black", // Settings:
    "Purple" // About:
  ],
  "todo-tree.highlights.backgroundColourScheme": [
    "White", // BUG:
    "White", // HACK:
    "White", // TODO:
    "DodgerBlue", // GUI:
    "Green", // F4SE:
    "Maroon", // Scanner:
    "Teal", // Overview:
    "Red", // Errors:
    "OrangeRed", // Conflicts:
    "Gold", // Suggestions:
    "Indigo", // Tools:
    "PeachPuff", // Settings:
    "Orchid" // About:
  ]
}
