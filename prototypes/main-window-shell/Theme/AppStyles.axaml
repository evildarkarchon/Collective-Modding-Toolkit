<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PROTOTYPE, every variant. These are the equivalents of utils.set_theme()'s style.configure(...) calls:
    app-wide font/foreground defaults, not shape changes, so they are not part of the A/B/C comparison.
  -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource CmtFont}" />
    <Setter Property="Background" Value="{DynamicResource SvBg}" />
    <Setter Property="Foreground" Value="{DynamicResource CmtDefault}" />
  </Style>

  <!--
    Text metrics that reproduce Tk/GDI layout (see SvPalette CmtLine*/CmtSpacing*). :is(TextBlock) rather than
    TextBlock because string content in Button/TabItem renders through AccessText, a TextBlock subclass, and a
    plain type selector only matches the exact type. Later styles win, so general first, specific after.
  -->
  <Style Selector=":is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource CmtFontNormal}" />
    <Setter Property="LineHeight" Value="{DynamicResource CmtLineNormal}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource CmtSpacingNormal}" />
  </Style>
  <!-- style.configure("TButton"/"TLabelframe.Label", font=FONT_SMALL, foreground=COLOR_DEFAULT) -->
  <Style Selector=":is(TextBlock).small, Button :is(TextBlock), TableView :is(TextBlock)">
    <Setter Property="FontSize" Value="{DynamicResource CmtFontSmall}" />
    <Setter Property="LineHeight" Value="{DynamicResource CmtLineSmall}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource CmtSpacingSmall}" />
  </Style>
  <!-- Tooltips are tk.Message in TkDefaultFont (Segoe UI 9 pt), not Cascadia: undo the Cascadia tuning. -->
  <Style Selector="ToolTip :is(TextBlock)">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="LetterSpacing" Value="0" />
  </Style>

  <!-- tkinter-tooltip defaults: delay=0, follow=True, +10/+10 from the pointer. -->
  <Style Selector=":is(Control)">
    <Setter Property="ToolTip.ShowDelay" Value="0" />
    <Setter Property="ToolTip.Placement" Value="Pointer" />
    <Setter Property="ToolTip.HorizontalOffset" Value="10" />
    <Setter Property="ToolTip.VerticalOffset" Value="10" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- style.configure("Heading", font=FONT_SMALL): regular weight, Fluent headers are SemiBold. -->
  <Style Selector="TableViewColumnHeader">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- ttk.Scrollbar is always visible with arrow buttons; Fluent's auto-hide overlay is not. -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
</Styles>
