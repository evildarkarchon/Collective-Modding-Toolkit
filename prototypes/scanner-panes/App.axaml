<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CmtPanesPrototype.App"
             RequestedThemeVariant="Dark">
  <!-- PROTOTYPE. The decided theme layers from "Prototype the main window shell and Overview tab", fixed at variant C. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CmtPanesPrototype/Theme/SvPalette.axaml" />
        <ResourceInclude Source="avares://CmtPanesPrototype/Theme/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#3CD648"
                               RegionColor="#1C1C1C"
                               BaseHigh="#FAFAFA"
                               ErrorText="#AF5A66"
                               ChromeMedium="#2A2A2A"
                               ChromeMediumLow="#1C1C1C"
                               ChromeLow="#1C1C1C"
                               AltHigh="#1C1C1C" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://CmtPanesPrototype/Theme/AppStyles.axaml" />
    <StyleInclude Source="avares://CmtPanesPrototype/Theme/ScannerStyles.axaml" />
  </Application.Styles>
</Application>
