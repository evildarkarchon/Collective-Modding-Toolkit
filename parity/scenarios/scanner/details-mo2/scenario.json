{
  "description": "MO2 stage mode with a relative game path (the working directory is the root), without the Address Library file but with its folder: the details pane has the Mod row (an empty mod shows N/A), and the relative paths are checked and opened against the working directory, so the Address Library's path opens its existing parent folder.",
  "operation": "scanner-details",
  "parity": [
    "SCN-R4",
    "SCN-R5",
    "SCN-R6",
    "SCN-R7"
  ],
  "emptyDirs": [
    "Game/Data/F4SE/Plugins"
  ],
  "host": {
    "cwd": "<ROOT>",
    "argv0": "cm-toolkit.exe",
    "env": {
      "LOCALAPPDATA": "<ROOT>\\LocalAppData"
    },
    "knownFolders": {
      "Documents": "<ROOT>\\Documents",
      "LocalAppData": "<ROOT>\\LocalAppData"
    },
    "registry": {
      "HKCU\\Software\\Mod Organizer Team\\Mod Organizer": {
        "CurrentInstance": {
          "type": "REG_SZ",
          "value": "Fallout 4"
        }
      },
      "HKLM\\Hardware\\Description\\System\\CentralProcessor\\0": {
        "ProcessorNameString": {
          "type": "REG_SZ",
          "value": "AMD Ryzen 7 7800X3D 8-Core Processor           "
        }
      },
      "HKLM\\HARDWARE\\DEVICEMAP\\VIDEO": {
        "\\Device\\Video0": {
          "type": "REG_SZ",
          "value": "\\Registry\\Machine\\System\\CurrentControlSet\\Control\\Video\\{00000000-0000-0000-0000-000000000000}\\0000"
        }
      },
      "HKLM\\System\\CurrentControlSet\\Control\\Video\\{00000000-0000-0000-0000-000000000000}\\0000": {
        "HardwareInformation.AdapterString": {
          "type": "REG_SZ",
          "value": "NVIDIA GeForce RTX 4070"
        },
        "HardwareInformation.qwMemorySize": {
          "type": "REG_QWORD",
          "value": 12884901888
        }
      }
    },
    "processes": [
      {
        "name": "ModOrganizer.exe",
        "exe": "<ROOT>/MO2/ModOrganizer.exe",
        "fileVersion": [
          2,
          5,
          2,
          0
        ]
      },
      {
        "name": "explorer.exe",
        "exe": "C:\\Windows\\explorer.exe"
      }
    ],
    "os": {
      "system": "Windows",
      "release": "11",
      "build": 26100
    },
    "pc": {
      "ramBytes": 34359738368
    }
  }
