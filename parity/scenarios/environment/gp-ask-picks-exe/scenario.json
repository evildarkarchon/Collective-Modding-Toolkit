{
  "description": "The user answers Yes and picks Fallout4.exe (Tk returns forward slashes); its folder is the game path (GP-2, GP-3).",
  "operation": "game-info",
  "parity": [
    "GP-2",
    "GP-3",
    "GP-4"
  ],
  "emptyDirs": [
    "Cwd",
    "Documents",
    "Game/Data"
  ],
