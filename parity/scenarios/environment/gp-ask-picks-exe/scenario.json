      {
        "function": "askyesno",
        "answer": true
      },
      {
        "function": "askopenfilename",
        "answer": "<ROOT>/Game/Fallout4.exe"
      }
    ],
    "knownFolders": {
      "Documents": "<ROOT>\\Documents"
    }
  }
}
