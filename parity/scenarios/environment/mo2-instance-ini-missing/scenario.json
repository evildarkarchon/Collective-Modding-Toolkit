{
  "description": "CurrentInstance is set but its INI doesn't exist, so the fallback reads the portable INI (no portable.txt) and marks the install portable.",
  "operation": "mod-manager",
  "parity": [
    "MO2-2",
    "MO2-3"
  ],
  "host": {
    "processes": [
      {
        "name": "ModOrganizer.exe",
        "exe": "<ROOT>/MO2/ModOrganizer.exe",
        "fileVersion": [
          2,
          5,
          2,
          0
        ]
      }
    ],
    "registry": {
      "HKCU\\Software\\Mod Organizer Team\\Mod Organizer": {
        "CurrentInstance": {
          "type": "REG_SZ",
          "value": "Fallout 4"
        }
      }
    },
    "env": {
      "LOCALAPPDATA": "<ROOT>\\LocalAppData"
    }
  }
}
