{
  "description": "No Fallout4.ccc and no plugins.txt, without a mod manager: two warnings on the load only, and every .esp/.esl/.esm in Data is counted, except those already listed as masters regardless of case (T-8); a folder named like a module is unreadable.",
  "operation": "overview-full",
  "parity": [
    "OVW-M3",
    "OVW-M5",
    "OVW-M6",
    "OVW-M8",
    "OVW-P8",
    "OVW-P9",
    "OVW-P10",
    "T-8"
  ],
  "emptyDirs": [
    "Game/Data/Folder.esp",
    "LocalAppData"
  ],
  "host": {
    "cwd": "<ROOT>/Cwd",
    "argv0": "cm-toolkit.exe",
    "env": {
      "LOCALAPPDATA": "<ROOT>\\LocalAppData"
    },
    "knownFolders": {
      "Documents": "<ROOT>\\Documents",
      "LocalAppData": "<ROOT>\\LocalAppData"
    },
    "registry": {
      "HKLM\\SOFTWARE\\WOW6432Node\\Bethesda Softworks\\Fallout4": {
        "Installed Path": {
          "type": "REG_SZ",
          "value": "<ROOT>\\Game"
        }
      },
      "HKLM\\Hardware\\Description\\System\\CentralProcessor\\0": {
        "ProcessorNameString": {
          "type": "REG_SZ",
          "value": "AMD Ryzen 7 7800X3D 8-Core Processor           "
        }
      },
      "HKLM\\HARDWARE\\DEVICEMAP\\VIDEO": {
        "\\Device\\Video0": {
          "type": "REG_SZ",
          "value": "\\Registry\\Machine\\System\\CurrentControlSet\\Control\\Video\\{00000000-0000-0000-0000-000000000000}\\0000"
        }
      },
      "HKLM\\System\\CurrentControlSet\\Control\\Video\\{00000000-0000-0000-0000-000000000000}\\0000": {
        "HardwareInformation.AdapterString": {
          "type": "REG_SZ",
          "value": "NVIDIA GeForce RTX 4070"
        },
        "HardwareInformation.qwMemorySize": {
          "type": "REG_QWORD",
          "value": 12884901888
        }
      }
    },
    "processes": [
      {
        "name": "explorer.exe",
        "exe": "C:\\Windows\\explorer.exe"
      }
    ],
    "os": {
      "system": "Windows",
      "release": "11",
      "build": 26100
    },
    "pc": {
      "ramBytes": 34359738368
    }
  }
}
