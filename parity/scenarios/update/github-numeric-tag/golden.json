{
  "banner": {
    "columnWeights": [
      1,
      1
    ],
    "labels": [
      {
        "background": "#98FB98",
        "column": 0,
        "cursor": null,
        "font": {
          "bold": false,
          "family": "Cascadia Mono",
          "size": 12,
          "underline": false
        },
        "foreground": "#006400",
        "image": "images/update-24.png",
        "opens": null,
        "padding": [
          5
        ],
        "sticky": "e",
        "text": "An update is available:",
        "tooltip": null
      },
      {
        "background": "#98FB98",
        "column": 1,
        "cursor": "hand2",
        "font": {
          "bold": true,
          "family": "Cascadia Mono",
          "size": 12,
          "underline": true
        },
        "foreground": "#36648B",
        "image": null,
        "opens": "https://github.com/RowanSkie/Collective-Modding-Toolkit",
        "padding": [
          0
        ],
        "sticky": "w",
        "text": "v0.7 (GitHub)",
        "tooltip": "Open GitHub"
      }
    ],
    "rowWeight": 1,
    "style": "Update.TFrame"
  },
  "httpRequests": [
    {
      "kwargs": {
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28"
        },
        "timeout": 5
      },
      "resource": "github-latest-release"
    }
  ],
  "updateCheck": {
    "display": {
      "log": [
        {
          "level": "DEBUG",
          "message": "Update Check : GitHub"
        },
        {
          "level": "INFO",
          "message": "Update Check : GitHub : Update Available : v0.7"
        }
      ]
    },
    "githubVersion": "0.7",
    "nexusVersion": null
  }
}
