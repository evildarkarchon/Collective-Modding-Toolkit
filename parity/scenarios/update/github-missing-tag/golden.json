{
  "banner": null,
  "httpRequests": [
    {
      "kwargs": {
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28"
        },
        "timeout": 5
      },
      "resource": "github-latest-release"
    }
  ],
  "updateCheck": {
    "display": {
      "log": [
        {
          "level": "DEBUG",
          "message": "Update Check : GitHub"
        },
        {
          "exception": true,
          "level": "ERROR",
          "message": "Update Check : GitHub : Failed"
        }
      ]
    },
    "githubVersion": null,
    "nexusVersion": null
  }
}
