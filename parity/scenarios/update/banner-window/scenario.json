{
  "description": "The shell machine (Steam install, no mod manager) with update_source both and both sources newer: drives the banner screenshot pair, and its banner is replayed like every update scenario.",
  "operation": "update-check",
  "parity": [
    "UPD-2",
    "SHELL-7"
  ],
  "emptyDirs": [
    "Game/Data"
  ],
  "host": {
    "cwd": "<ROOT>/Cwd",
    "argv0": "cm-toolkit.exe",
    "env": {
      "LOCALAPPDATA": "<ROOT>\\LocalAppData"
    },
    "knownFolders": {
      "Documents": "<ROOT>\\Documents",
      "LocalAppData": "<ROOT>\\LocalAppData"
    },
    "registry": {
      "HKLM\\SOFTWARE\\WOW6432Node\\Bethesda Softworks\\Fallout4": {
        "Installed Path": {
          "type": "REG_SZ",
          "value": "<ROOT>\\Game"
        }
      },
      "HKLM\\Hardware\\Description\\System\\CentralProcessor\\0": {
        "ProcessorNameString": {
          "type": "REG_SZ",
          "value": "AMD Ryzen 7 7800X3D 8-Core Processor           "
        }
      },
      "HKLM\\HARDWARE\\DEVICEMAP\\VIDEO": {
        "\\Device\\Video0": {
          "type": "REG_SZ",
          "value": "\\Registry\\Machine\\System\\CurrentControlSet\\Control\\Video\\{00000000-0000-0000-0000-000000000000}\\0000"
        }
      },
      "HKLM\\System\\CurrentControlSet\\Control\\Video\\{00000000-0000-0000-0000-000000000000}\\0000": {
        "HardwareInformation.AdapterString": {
          "type": "REG_SZ",
          "value": "NVIDIA GeForce RTX 4070"
        },
        "HardwareInformation.qwMemorySize": {
          "type": "REG_QWORD",
          "value": 12884901888
        }
      }
    },
    "processes": [
      {
        "name": "explorer.exe",
        "exe": "C:\\Windows\\explorer.exe"
      }
    ],
    "os": {
      "system": "Windows",
      "release": "11",
      "build": 26100
    },
    "pc": {
      "ramBytes": 68719476736
    }
  },
  "deviations": [
    {
      "bug": 83,
      "reason": "The port drops the surrounding whitespace and leading v that PEP 440 allows from a newer version before adding its own v, so the banner and log read v0.7.0, not vv0.7.0."
    },
    {
      "bug": 32,
      "reason": "The update check and the GitHub link both point at evildarkarchon/Collective-Modding-Toolkit, which publishes the C# releases."
    }
  ]
}
