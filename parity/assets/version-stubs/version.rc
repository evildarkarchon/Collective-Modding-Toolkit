// The version resource of a stub binary. build.ps1 passes the four file-version parts as VER_MAJOR, VER_MINOR,
// VER_BUILD and VER_PRIVATE, and STUB_DLL for a DLL. The Overview reads only VS_FIXEDFILEINFO's FileVersionMS/LS
// (utils.get_file_version), so the string table is just a label saying what the file is.
#include <winver.h>

#ifdef STUB_DLL
#define STUB_FILETYPE VFT_DLL
#else
#define STUB_FILETYPE VFT_APP
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR, VER_MINOR, VER_BUILD, VER_PRIVATE
 PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_BUILD, VER_PRIVATE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE STUB_FILETYPE
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Collective Modding Toolkit parity stub (not a game file)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
